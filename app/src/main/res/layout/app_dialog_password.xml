<?xml version="1.0" encoding="utf-8"?>
<!--
  密码输入专用对话框：结构完全复用 app_dialog_input.xml，
  仅多一行「记住密码」勾选（使用与删除对话框相同的复选框样式）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#00FFFFFF"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="16dp"
        tools:ignore="RtlHardcoded">

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/app_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:gravity="center"
                android:textSize="@dimen/base_text_hlarge"
                android:textColor="@color/base_black"
                tools:text="需要验证密码" />

            <EditText
                android:id="@+id/app_et_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="8dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                android:maxLines="1"
                android:inputType="textPassword"
                android:textCursorDrawable="@drawable/app_text_cursor_red"
                android:theme="@style/AppEditText"
                android:textSize="@dimen/base_text_large" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="4dp">

                <CheckBox
                    android:id="@+id/app_cb_remember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.8"
                    android:scaleY="0.8"
                    android:button="@drawable/app_sel_main_select"
                    android:background="@null"
                    android:clickable="false"
                    android:checked="true"
                    tools:ignore="RtlSymmetry" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textSize="@dimen/base_text_small"
                    android:textColor="@color/base_black_shallow"
                    android:text="@string/app_remember_password" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.7dp"
                android:layout_marginTop="12dp"
                android:background="@color/base_black_divider_shallow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/app_btn_cancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/base_black_hint"
                    android:textSize="@dimen/base_text_large"
                    tools:text="取消" />

                <View
                    android:layout_width="0.7dp"
                    android:layout_height="match_parent"
                    android:background="@color/base_black_divider_shallow" />

                <Button
                    android:id="@+id/app_btn_confirm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/app_color_accent"
                    android:textSize="@dimen/base_text_large"
                    tools:text="确定" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
